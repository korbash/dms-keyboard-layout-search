{
  "id": "keyboardLayoutSearch",
  "name": "DMS Keyboard Layout Search",
  "description": "Search apps, settings and launcher sources across keyboard layouts.",
  "version": "1.1.0",
  "author": "korbash",
  "type": "composite",
  "icon": "keyboard",
  "capabilities": [
    "daemon",
    "launcher"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ],
  "requires_dms": ">=1.6.2",
  "license": "MIT",
  "settings": "./Settings.qml",
  "dependencies": [
    "python3",
    "libxkbcommon",
    "xkeyboard-config",
    "xkbcli"
  ],
  "components": {
    "daemon": "./LayoutSearchDaemon.qml",
    "launcher": "./LayoutSearchLauncher.qml"
  },
  "trigger": ""
}
